{
	"name": "@kodentuzo/tape",
	"version": "0.0.0",
	"description": "Read, check and write tape.json: what an app is called.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schema": "./tape.schema.json"
	},
	"files": [
		"dist",
		"tape.schema.json"
	],
	"scripts": {
		"check": "tsc --noEmit",
		"schema": "node scripts/schema.ts",
		"build": "node scripts/schema.ts && tsc --project tsconfig.build.json",
		"try": "node scripts/try.ts"
	},
	"dependencies": {
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@valibot/to-json-schema": "1.8.0"
	}
}
